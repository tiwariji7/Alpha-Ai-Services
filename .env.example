# ==============================================================================
# ALPHA AI SERVICES — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND PUBLIC / BUILD-TIME VARIABLES (Exposed to browser via Vite)
# ------------------------------------------------------------------------------
# Cloudflare Turnstile Site Key (Managed Mode)
# For local testing, you can use Cloudflare's always-pass test site key: 1x00000000000000000000AA
# In production, use your domain-bound Turnstile Site Key.
VITE_TURNSTILE_SITE_KEY="0x4AAAAAAEiHWfgLv2eycKkd"

# ------------------------------------------------------------------------------
# CLOUDFLARE BACKEND SECRETS (Set in Cloudflare Pages dashboard / Wrangler secret)
# NEVER prefix with VITE_ or expose to the frontend.
# ------------------------------------------------------------------------------
# Cloudflare Turnstile Secret Key
# For local testing with always-pass site key, secret is: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY="your_turnstile_secret_key_here"

# Resend API Key (https://resend.com)
RESEND_API_KEY="re_your_resend_api_key_here"

# Admin notification recipient email
ADMIN_EMAIL="info@alphaaiservices.in"

# Outgoing email sender (Domain verified in Resend)
EMAIL_FROM="Alpha AI Services <noreply@alphaaiservices.in>"
